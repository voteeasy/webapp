# Maven build output (also in submodules)
target/

# IDE metadata: IntelliJ IDEA, Eclipse, VS Code and NetBeans
/.idea/*
# Share only the project code style; keep personal IDE metadata ignored.
!/.idea/codeStyles/
/.idea/codeStyles/*
!/.idea/codeStyles/Project.xml
!/.idea/codeStyles/codeStyleConfig.xml
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.factorypath
.vscode/
nbproject/private/

# Operating system files
.DS_Store
._*
Thumbs.db
Desktop.ini

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Keep the Maven wrapper versioned
!.mvn/wrapper/maven-wrapper.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
